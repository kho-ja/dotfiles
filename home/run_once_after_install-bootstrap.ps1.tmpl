$ErrorActionPreference = "Stop"

# Bootstrap: ensure what running the setup needs is present (winget + scoop).
# run_once_after_ - runs once on the first apply, then never again.

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "winget not found - skipping winget package bootstrap"
} else {
    $ids = @(
{{- range .winget_setup }}
        "{{ . }}"
{{- end }}
    )
    foreach ($id in $ids) {
        winget list --id $id --exact --accept-source-agreements *> $null
        if ($LASTEXITCODE -ne 0) {
            Write-Host "Installing $id via winget"
            winget install --id $id --exact --silent --accept-package-agreements --accept-source-agreements
            if ($LASTEXITCODE -ne 0) {
                throw "Failed to install $id"
            }
        }
    }
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing scoop"
    Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-Expression (irm get.scoop.sh -UseBasicParsing)
}

$buckets = scoop bucket list 2>$null
if ($buckets -notmatch "extras") {
    Write-Host "Adding scoop bucket: extras"
    scoop bucket add extras
}

scoop update *> $null